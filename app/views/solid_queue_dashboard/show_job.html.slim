.container
  .mb-3
    = link_to '← Back to Dashboard', solid_queue_dashboard_path, class: 'btn btn-secondary'

  .card
    .card-header
      h3 Job Details ##{@job.id}
    .card-body
      .row
        .col-md-6
          table.table.table-borderless
            tr
              th ID
              td = @job.id
            tr
              th Queue
              td = @job.queue_name
            tr
              th Class Name
              td = @job.class_name
            tr
              th Priority
              td = @job.priority || 'default'
        .col-md-6
          table.table.table-borderless
            tr
              th Created At
              td = @job.created_at.strftime('%Y-%m-%d %H:%M:%S')
            tr
              th Scheduled At
              td = @job.scheduled_at&.strftime('%Y-%m-%d %H:%M:%S') || 'Immediately'
            tr
              th Finished At
              td = @job.finished_at&.strftime('%Y-%m-%d %H:%M:%S') || 'Not finished'
            tr
              th Failed At
              td = @job.failed_at&.strftime('%Y-%m-%d %H:%M:%S') || 'Not failed'

      - if @job.arguments.present?
        h5 Arguments
        pre.bg-light.p-3.rounded = JSON.pretty_generate(@job.arguments)

      - if @job.error_message.present?
        h5.text-danger Error Message
        pre.bg-danger.text-white.p-3.rounded = @job.error_message

      .mt-3
        - if @job.failed_at.present?
          = link_to 'Retry Job', retry_solid_queue_dashboard_job_path(@job), method: :post, class: 'btn btn-warning'
        = link_to 'Delete Job', delete_solid_queue_dashboard_job_path(@job), method: :post, class: 'btn btn-danger ms-2', confirm: 'Are you sure you want to delete this job?'